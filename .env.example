# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# NEVER put a secret in a NEXT_PUBLIC_* variable — those are inlined into the
# JavaScript bundle and shipped to every browser. scripts/check-secrets.ts fails
# the test run if that happens.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Dashboard > Project Settings > API Keys > service_role ("secret").
# Bypasses RLS. Used only by webhook, cron and seed paths.
SUPABASE_SERVICE_ROLE_KEY=

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# openssl rand -base64 32  (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
# Mixed into the approval-token hash. Rotating it invalidates every live token.
TOKEN_PEPPER=
# Bearer secret for POST /api/cron/*. Compared timing-safely.
CRON_SECRET=

# --- Email ------------------------------------------------------------------
# fake   = writes to dev_sent_emails, /dev/mailbox can reply as the manager
# resend = live sending + real inbound webhook
EMAIL_PROVIDER=fake
EMAIL_FROM=Awign Travel <approvals@awign.example>
EMAIL_REPLY_TO_BASE=approvals@awign.example

# Svix signing secret for the inbound webhook. The fake provider signs its
# simulated deliveries with this too, so local runs exercise the real
# verification path. Replace with Resend's value when the domain is live.
EMAIL_WEBHOOK_SECRET=whsec_

# Resend can only send to the account owner until a sending domain is verified.
# Set this to your own inbox for the first live smoke test; every outbound mail
# is rerouted there with the true recipient preserved in a header.
# EMAIL_REDIRECT_TO=you@example.com
RESEND_API_KEY=

# --- Dev tools --------------------------------------------------------------
# Gates /dev/mailbox and the inbound simulator, which can forge approvals.
# Refused outright when NODE_ENV=production.
ENABLE_DEV_TOOLS=true

# --- Policy -----------------------------------------------------------------
REQUEST_EXPIRY_DAYS=7
REMINDER_AFTER_DAYS=3
MAX_CLARIFICATIONS=2
